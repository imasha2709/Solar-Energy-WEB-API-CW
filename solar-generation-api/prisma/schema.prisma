generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  code      String     @unique

  districts District[]
  users     User[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id         Int       @id @default(autoincrement())
  name       String
  code       String    @unique

  provinceId Int
  province   Province  @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  substations GridSubstation[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([provinceId])
}

model GridSubstation {
  id         Int       @id @default(autoincrement())
  name       String
  code       String    @unique

  districtId Int
  district   District  @relation(fields: [districtId], references: [id], onDelete: Restrict)

  installations SolarInstallation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([districtId])
}

model SolarInstallation {
  id           Int             @id @default(autoincrement())
  name         String
  meterId      String          @unique
  inverterId   String?         @unique

  capacityKw   Decimal         @db.Decimal(10, 2)
  latitude     Decimal         @db.Decimal(9, 6)
  longitude    Decimal         @db.Decimal(9, 6)

  active       Boolean         @default(true)

  substationId Int
  substation   GridSubstation  @relation(fields: [substationId], references: [id], onDelete: Restrict)

  readings     GenerationReading[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([substationId])
}

model GenerationReading {
  id             BigInt            @id @default(autoincrement())

  installationId Int
  installation   SolarInstallation  @relation(fields: [installationId], references: [id], onDelete: Restrict)

  timestamp      DateTime

  powerKw        Decimal           @db.Decimal(10, 3)
  cumulativeKwh  Decimal           @db.Decimal(12, 3)
  voltage        Decimal           @db.Decimal(8, 2)

  createdAt      DateTime           @default(now())

  @@unique([installationId, timestamp])
  @@index([installationId, timestamp])
  @@index([timestamp])
}

enum UserRole {
  NATIONAL_ANALYST
  PROVINCE_ANALYST
  DISTRICT_ANALYST
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String

  role         UserRole

  provinceId   Int?
  province     Province?  @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  districtId   Int?
  district     District?  @relation(fields: [districtId], references: [id], onDelete: Restrict)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([provinceId])
  @@index([districtId])
}